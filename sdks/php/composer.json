{
  "name": "lshorter/lshorter-api",
  "description": "Official PHP SDK for LShorter — Ultra-fast Edge URL Shortener, Dynamic Routing, PathLock™, and Conversion Tracking.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://lsho.cc",
  "keywords": [
    "lshorter",
    "url-shortener",
    "short-link",
    "analytics",
    "conversion-tracking",
    "edge-redirect"
  ],
  "authors": [
    {
      "name": "KONVELBO Samuel",
      "homepage": "https://lsho.cc"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "LShorter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LShorter\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable"
}
