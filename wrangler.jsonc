{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lshorter-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],

  // ─── Variables non-sensibles (publiques) ──────────────────────────────────
  "vars": {
    "DEFAULT_DOMAIN": "lsho.cc"
  },

  // ─── Variables sensibles ──────────────────────────────────────────────────
  // CF_ACCOUNT_ID et CF_API_TOKEN doivent être définis via :
  //   npx wrangler secret put CF_ACCOUNT_ID
  //   npx wrangler secret put CF_API_TOKEN
  // Elles seront alors chiffrées et injectées automatiquement par Cloudflare.

  // ─── Cache KV (redirections rapides) ─────────────────────────────────────
  "kv_namespaces": [
    {
      "binding": "URL_KV",
      "id": "26a244d5e6c54e99bd608c4c5ec47f86",
    },
  ],

  // ─── Base de données D1 (SQLite) ──────────────────────────────────────────
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quicklink-db",
      "database_id": "08169b58-e8d7-491e-9a4c-cd74771c359a",
    },
  ],
}
