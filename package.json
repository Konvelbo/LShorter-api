{
  "name": "lshorter-api",
  "version": "2.0.4",
  "description": "Official TypeScript / JavaScript SDK for LShorter Edge URL Shortener & Analytics",
  "author": "KONVELBO Samuel",
  "homepage": "https://lsho.cc",
  "license": "MIT",
  "keywords": [
    "lshorter",
    "url-shortener",
    "short-link",
    "edge-redirect",
    "analytics",
    "conversion-tracking"
  ],
  "type": "module",
  "main": "./dist/sdk.cjs",
  "module": "./dist/sdk.js",
  "types": "./dist/sdk.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build:sdk": "tsup src/sdk.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "pnpm run build:sdk",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 execute quicklink-db --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute quicklink-db --local --file=./schema.sql",
    "db:incremental": "wrangler d1 execute quicklink-db --remote --file=./scripts/migrate.sql",
    "test": "node ./node_modules/jest/bin/jest.js --config jest.config.cjs"
  },
  "dependencies": {
    "hono": "^4.12.32",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.6",
    "@cloudflare/workers-types": "^4.20250718.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.110.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@parcel/watcher",
      "unrs-resolver"
    ]
  }
}